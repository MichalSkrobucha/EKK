/* --- GŁÓWNE USTAWIENIA --- */
QMainWindow {
    background-color: #1e1e2e;
}

QWidget {
    color: #f8f8f2;
    font-family: 'Segoe UI', sans-serif;
    font-size: 13px;
}

/* --- PIONOWE ZAKŁADKI (Lewy pasek) --- */
QTabWidget::pane {
    border: none;
}

/* Zakładki, gdy są ustawione po lewej stronie */
QTabBar::tab:left {
    background: #282a36;
    color: #bd93f9;
    padding: 15px 10px;
    margin-bottom: 2px;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    min-width: 80px;
    font-weight: bold;
}

QTabBar::tab:left:selected {
    background: #44475a;
    color: #ff79c6;
    border-right: 3px solid #ff79c6;
}

/* --- POZIOME ZAKŁADKI (Górny pasek) --- */
QTabBar::tab:top {
    background: #44475a;
    color: #f8f8f2;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:top:selected {
    background: #6272a4;
    font-weight: bold;
}

/* --- ELEMENTY WEWNĘTRZNE --- */
QGroupBox {
    border: 1px solid #6272a4;
    border-radius: 5px;
    margin-top: 20px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QTextEdit {
    background-color: #282a36;
    border: 1px solid #44475a;
}

QPushButton {
    background-color: #bd93f9;
    color: #282a36;
    border-radius: 3px;
    padding: 5px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #ff79c6;
}